<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeFragment">

    <!-- Home Fragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.shade.ui.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <!-- Scan Fragment -->
    <fragment
        android:id="@+id/scanFragment"
        android:name="com.example.shade.ui.fragments.ScanFragment"
        android:label="Scan"
        tools:layout="@layout/fragment_scan" />

    <!-- Threats Fragment -->
    <fragment
        android:id="@+id/threatsFragment"
        android:name="com.example.shade.ui.fragments.ThreatsFragment"
        android:label="Threats"
        tools:layout="@layout/fragment_threats" />

    <!-- Settings Fragment -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.shade.ui.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
        android:id="@+id/action_settingsFragment_to_helpFragment"
        app:destination="@id/helpFragment" />
    </fragment>

    <fragment
        android:id="@+id/helpFragment"
        android:name="com.example.shade.ui.fragments.HelpFragment"
        android:label="Help" />

</navigation>
